# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Neon PostgreSQL Database Connection String
# Replace with your own Neon connection URL on Render Environment Variables
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_MIN_CONN=1
DB_MAX_CONN=10
DB_TIMEOUT=30

# Security (Set a strong secret key in Render settings)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Application Settings
ITEMS_PER_PAGE=12
ORDERS_PER_PAGE=10
